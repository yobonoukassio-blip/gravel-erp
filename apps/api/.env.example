# ─── Gravel API — variables d'environnement ───────────────────────────────────
# Copier ce fichier en .env et renseigner les valeurs
# Voir docs/operations/neon-setup.md pour obtenir DATABASE_URL et REDIS_URL

NODE_ENV=development
PORT=3000

# PostgreSQL — Supabase (projet: qrkfkfhzavqjorhrlluj)
# Mot de passe DB → Supabase Dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.qrkfkfhzavqjorhrlluj:VOTRE_MOT_DE_PASSE_DB@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Supabase project
SUPABASE_URL=https://qrkfkfhzavqjorhrlluj.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFya2ZrZmh6YXZxam9yaHJsbHVqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg2MjE1OTgsImV4cCI6MjA5NDE5NzU5OH0.mDNeXSAg8_lFjbJSy0O3exguQXMSQ-jCtECONGu5a7w
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFya2ZrZmh6YXZxam9yaHJsbHVqIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3ODYyMTU5OCwiZXhwIjoyMDk0MTk3NTk4fQ.PO_owUou_TQpYm5NpuDn7Buz5_lGcT4tKeei8aTfghk

# Redis — Upstash cloud (console.upstash.com → base Gravel → Connect → Node.js)
# ATTENTION : rediss:// (double s) = TLS obligatoire
REDIS_URL=rediss://default:TOKEN@selected-porpoise-122513.upstash.io:6379

# Auth — mettre true en dev pour désactiver la validation JWT Keycloak
DEV_BYPASS_JWT=true
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=gravel-dev
KEYCLOAK_AUDIENCE=gravel-api

# AWS S3 — HSE attachments. Mettre S3_DISABLED=true en dev local
S3_DISABLED=true
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_HSE_BUCKET=gravel-dev-hse-attachments

# CORS — origines autorisées en plus de localhost:4200 (séparer par virgule)
# Ex: https://gravel-erp.vercel.app,https://staging-gravel.vercel.app
CORS_ORIGINS=

# Observabilité
OTEL_SDK_DISABLED=true
TYPEORM_LOGGING=false
