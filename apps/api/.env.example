# ─── Gravel API — variables d'environnement ───────────────────────────────────
# Copier ce fichier en .env et renseigner les valeurs
# Voir docs/operations/neon-setup.md pour obtenir DATABASE_URL et REDIS_URL
#
# ⚠️  SECURITY (P0-1, audit 2026-05-16) : NE JAMAIS commiter de vraies clés ici.
#     L'historique git de ce fichier contient des clés Supabase live qui DOIVENT
#     être rotées via le dashboard Supabase, puis l'historique purgé via BFG
#     ou `git filter-repo`.

# ─── ROTATION ────────────────────────────────────────────────────────────────
# Every secret in this file has a rotation procedure in
#   .planning/runbooks/secrets-rotation.md
# Cadences: Keycloak/DB = 90d, BREVO/TWILIO/AWS = 180d, JWT key = 365d (dual-key).
# Log every rotation in .planning/drills/rotations-{YYYY}.md

NODE_ENV=development
PORT=3000

# PostgreSQL — Supabase
# Mot de passe DB → Supabase Dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres

# Supabase project
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<rotate_and_paste_anon_key_here>
SUPABASE_SERVICE_ROLE_KEY=<rotate_and_paste_service_role_key_here>

# Redis — Upstash cloud (console.upstash.com → base Gravel → Connect → Node.js)
# ATTENTION : rediss:// (double s) = TLS obligatoire
REDIS_URL=rediss://default:<TOKEN>@<host>.upstash.io:6379

# Auth — DEV_BYPASS_JWT n'a AUCUN EFFET en production (P0-4). Garder à false ici par défaut.
DEV_BYPASS_JWT=false
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=gravel-dev
KEYCLOAK_AUDIENCE=gravel-api

# Auth locale (FND-01 demo path) — secret HS256 pour /auth/login + JwtAuthGuard.
# Générer en prod : openssl rand -hex 64. Doit faire ≥ 32 bytes.
# Si vide, le chemin local est désactivé et seul Keycloak RS256 fonctionne.
AUTH_JWT_SECRET=

# AWS S3 — HSE attachments. Mettre S3_DISABLED=true en dev local
S3_DISABLED=true
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_HSE_BUCKET=gravel-dev-hse-attachments

# CORS — origines autorisées en plus de localhost:4200 (séparer par virgule)
# Ex: https://gravel-erp.vercel.app,https://staging-gravel.vercel.app
CORS_ORIGINS=

# Observabilité
OTEL_SDK_DISABLED=true
TYPEORM_LOGGING=false

# Schema sync — TOUJOURS false en prod. Voir P0-7 in app.module.ts.
TYPEORM_SYNCHRONIZE=false

# Postgres TLS verification — FINDING-009. Default verify on (recommended).
# Set to false UNIQUEMENT pour cert self-signed; Supabase = CA-signed → laisser true.
PG_SSL_REJECT_UNAUTHORIZED=true

# ─── Phase 9 — Notification Delivery ──────────────────────────────────────────

# Brevo (ex-Sendinblue) — email transactionnel
# Récupérer la clé API sur https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=alerts@gravel-ivoire.app
BREVO_SENDER_NAME=Gravel Ivoire

# Twilio — SMS
# Récupérer sur https://console.twilio.com → Account → API keys & tokens
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Notifications — dry-run mode (default: true en dev, false en prod)
# Mettre à false pour envoyer de vrais emails/SMS depuis l'environnement local.
NTF_DRY_RUN=true
