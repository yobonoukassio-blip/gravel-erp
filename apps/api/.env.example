# ─── Gravel API — variables d'environnement ───────────────────────────────────
# Copier ce fichier en .env et renseigner les valeurs
# Voir docs/operations/neon-setup.md pour obtenir DATABASE_URL et REDIS_URL

NODE_ENV=development
PORT=3000

# PostgreSQL — Neon (console.neon.tech) OU Supabase (console.supabase.com)
# Neon  : postgresql://neondb_owner:PASS@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Supa  : postgresql://postgres:PASS@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Supabase project (pour Auth Phase 3 — remplace Keycloak)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis — Upstash cloud (console.upstash.com → base Gravel → Connect → Node.js)
# ATTENTION : rediss:// (double s) = TLS obligatoire
REDIS_URL=rediss://default:TOKEN@selected-porpoise-122513.upstash.io:6379

# Auth — mettre true en dev pour désactiver la validation JWT Keycloak
DEV_BYPASS_JWT=true
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=gravel-dev
KEYCLOAK_AUDIENCE=gravel-api

# AWS S3 — HSE attachments. Mettre S3_DISABLED=true en dev local
S3_DISABLED=true
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_HSE_BUCKET=gravel-dev-hse-attachments

# CORS — origines autorisées en plus de localhost:4200 (séparer par virgule)
# Ex: https://gravel-erp.vercel.app,https://staging-gravel.vercel.app
CORS_ORIGINS=

# Observabilité
OTEL_SDK_DISABLED=true
TYPEORM_LOGGING=false
