{
  "name": "@gravel/api",
  "version": "0.1.0",
  "private": true,
  "description": "Gravel Ivoire ERP API — NestJS 11 modular monolith (identity, tenancy, master-data, sync, audit, i18n, health).",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test:quick": "jest --selectProjects unit",
    "test:ci": "jest --runInBand",
    "test:int": "jest --selectProjects integration",
    "test:rls-leak": "jest --selectProjects security",
    "test:chaos": "jest --selectProjects chaos",
    "lint": "eslint src test --ext .ts --max-warnings=0",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d ormconfig.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d ormconfig.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d ormconfig.ts",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "db:seed:user": "psql \"$DATABASE_URL\" -f scripts/seed-dev-user.sql"
  },
  "dependencies": {
    "@nestjs/core": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/schedule": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "nestjs-cls": "^5.0.0",
    "nestjs-pino": "^4.1.0",
    "nestjs-i18n": "^10.5.0",
    "@willsoto/nestjs-prometheus": "^6.0.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.55.0",
    "@opentelemetry/sdk-metrics": "^1.28.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "typeorm": "^0.3.20",
    "pg": "^8.13.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "jwks-rsa": "^3.1.0",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "dinero.js": "2.0.0-alpha.14",
    "@dinero.js/currencies": "2.0.0-alpha.14",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "@casl/ability": "^6.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "pino-http": "^10.4.0",
    "@gravel/shared-types": "workspace:*",
    "@gravel/i18n": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/jest": "^29.5.13",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.0",
    "@testcontainers/postgresql": "^10.13.0",
    "typescript": "~5.9.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0"
  }
}
