{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && NODE_ENV=development pnpm install && pnpm --filter @gravel/shared-types build && pnpm --filter @gravel/web build",
  "outputDirectory": "dist/web/browser",
  "installCommand": "echo 'install handled by buildCommand'",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://$API_HOST/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://$API_HOST/health/:path*"
    },
    {
      "source": "/((?!api/|health/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|ico|png|jpg|jpeg|gif|svg|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
