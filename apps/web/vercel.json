{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo prebuilt",
  "outputDirectory": "dist/web/browser",
  "installCommand": "echo skip",
  "framework": null,
  "rewrites": [
    {"source":"/api/:path*","destination":"https://gravel-erp-production.up.railway.app/api/:path*"},
    {"source":"/health/:path*","destination":"https://gravel-erp-production.up.railway.app/health/:path*"},
    {"source":"/((?!api/|health/).*)","destination":"/index.html"}
  ]
}
